# 이미지에 넣지 않을 파일들 (용량 절약 + 비밀값 유출 방지)

# 의존성은 이미지 안에서 npm ci로 새로 설치
node_modules

# 비밀값 — 절대 이미지에 포함하지 않는다
.env
.env.*
!.env.example

# Git / CI / 에디터
.git
.github
.gitignore
.vscode
.DS_Store

# 개발·테스트 전용
tests
coverage
eslint.config.js
docker-compose.yml
docker
*.diff
*.log

# 업로드된 파일은 볼륨으로 관리
uploads
