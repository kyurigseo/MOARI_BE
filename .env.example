# 이 파일을 복사해 .env로 만들고 값을 채우세요. (.env는 Git에 올라가지 않습니다)
#   cp .env.example .env

# --- 직접 실행(npm start)할 때 ---
PORT=3000
DB_HOST=localhost
# docker compose로 띄운 MySQL에 붙을 때는 3307 (compose가 3307로 노출)
DB_PORT=3307
DB_USER=moari
DB_PASSWORD=moaripass
DB_NAME=moari_db

# --- docker compose에서도 사용 ---
MYSQL_ROOT_PASSWORD=rootpass
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# AI 기능 (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=

# 이메일 인증 (Gmail SMTP)
MAIL_USER=
MAIL_PASS=
